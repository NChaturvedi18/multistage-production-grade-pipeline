pipeline {
    agent any
        tools {
        nodejs 'Node-Yarn' // This must exactly match the Name you gave it in Step 2
    }
    stages{
        stage('Checkout') {
            steps {
                echo 'Checking out the code...'
                checkout scm
            }
        }
        stage('Build') {
            steps {
                echo 'Building the JS application...'
                dir('src') {
                    sh 'bash build.sh'
                }
            }
        }
        stage('Test') {
            steps {
                echo 'Running tests...'
                dir('src') {
                    sh 'bash test.sh'
                }
            }
        }
        stage('Package') {
            steps {
                echo 'Packaging the application...'
                dir('src') {
                    sh 'bash package.sh'
                }
            }
        }
        stage('Generate Artifacts') {
            steps {
                echo 'Generating artifacts...'
                dir('src') {
                    sh 'bash artifacts-upload.sh'
                }
            }
        }
        stage('Deploy') {
            steps {
                echo 'Deploying the application...'
                dir('src') {
                    sh 'bash deploy.sh'
                }
            }
        }
    }
    post {
        always {
            echo 'Notifying stakeholders...'
            dir('src') {
                sh 'bash notify.sh'
            }
        }
    }
}