pipeline {
    agent any
        tools {
        nodejs 'Node-Yarn' // This must exactly match the Name you gave it in Step 2
    }
    stages{
        stage('Checkout') {
            steps {
                echo 'Checking out the code...'
                checkout scm
            }
        }
        stage('Build') {
            steps {
                echo 'Building the JS application...'
                sh "bash ${env.WORKSPACE}/ci/Scripts/build.sh"
            }
        }
        stage('Test') {
            steps {
                echo 'Running tests...'
                sh "bash ${env.WORKSPACE}/ci/Scripts/test.sh"
            }
        }
        stage('Package') {
            steps {
                echo 'Packaging the application...'
                sh "bash ${env.WORKSPACE}/ci/Scripts/package.sh"
            }
        }
        stage('Generate Artifacts') {
            steps {
                echo 'Generating artifacts...'
                sh "bash ${env.WORKSPACE}/ci/Scripts/artifacts-upload.sh"
            }
        }
        stage('Deploy') {
            steps {
                echo 'Deploying the application...'
                sh "bash ${env.WORKSPACE}/ci/Scripts/deploy.sh"
            }
        }
    }
    post {
    success {
        // 1. Safely bind your secure credentials for the success condition
        withCredentials([usernamePassword(credentialsId: 'Neha.Chaturvedi181993', 
                                            usernameVariable: 'SMTP_USER', 
                                            passwordVariable: 'SMTP_PASS')]) {
            
            echo 'Pipeline succeeded! Triggering notification script...'
            
            # 2. Execute your clean shell script file safely
                    sh "bash ${env.WORKSPACE}/ci/Scripts/notify.sh"
        }
    }
    
    failure {
        echo 'Pipeline failed. Notification script skipped or can be handled here.'
    }
}
}