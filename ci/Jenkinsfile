pipeline {
    agent any
        tools {
        nodejs 'Node-Yarn' // This must exactly match the Name you gave it in Step 2
    }
    stages{
        stage('Checkout') {
            steps {
                echo 'Checking out the code...'
                checkout scm
            }
        }
        stage('Install Dependencies') {
            steps {
                echo 'Installing dependencies...'
                dir('src') {
                    sh '''
                        npm install -g yarn || true
                        yarn install
                        yarn --version
                    '''
                }
            }
        }
        stage('Build') {
            steps {
                echo 'Building the JS application...'
                dir('src') {
                    sh 'yarn build'
                }
            }
        }
        stage('Test') {
            steps {
                echo 'Running tests...'
                dir('src') {
                    sh 'yarn test'
                }
            }
        }
        stage('Deploy') {
            steps {
                echo 'Deploying the application...'
                dir('src') {
                    sh 'yarn deploy'
                }
            }
        }
    }
    post {
        always {
            echo 'Cleaning up...'
            dir('src') {
                sh 'yarn clean'
            }
        }
    }
}